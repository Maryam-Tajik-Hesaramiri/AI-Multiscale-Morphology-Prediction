    # -------------------------------------------------------------------------

    ensemble_weights = (
        calculate_ensemble_weights(
            base_comparison
        )
    )

    all_predictions = (
        add_ensemble_predictions(
            base_predictions,
            ensemble_weights,
        )
    )

    final_comparison = (
        summarize_models(
            all_predictions
        )
    )

    # -------------------------------------------------------------------------
    # Model selection
    # -------------------------------------------------------------------------

    selected_predictors = (
        select_final_predictors(
