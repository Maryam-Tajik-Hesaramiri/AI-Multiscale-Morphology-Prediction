def save_figure(
    fig,
    path: Path,
) -> None:
    """Save figures as both PNG and PDF."""

    fig.tight_layout()

    fig.savefig(
        path.with_suffix(
            ".png"
        ),
        dpi=300,
        bbox_inches="tight",
    )

    fig.savefig(
        path.with_suffix(
            ".pdf"
        ),
        bbox_inches="tight",
    )

    plt.close(
        fig
    )


def plot_model_comparison(
    comparison_df: pd.DataFrame,
    figure_dir: Path,
    target: str,
) -> None:
    """Plot LORO RMSE for all candidate models."""

    subset = (
        comparison_df[
            comparison_df[
                "target"
            ]
            == target
        ]
        .sort_values(
            "RMSE"
        )
    )

    fig, ax = plt.subplots(
        figsize=(8.5, 5)
    )

    ax.bar(
        subset[
            "model"
        ],
        subset[
            "RMSE"
        ],
    )

    ax.set_ylabel(
        f"LORO RMSE "
        f"({UNITS[target]})"
    )

    ax.set_xlabel(
        "Model"
    )

    ax.set_title(
        f"{target}: "
        "model comparison"
    )

    ax.tick_params(
        axis="x",
        rotation=30,
    )

    save_figure(
        fig,
        figure_dir
        / f"{target.lower()}_model_comparison",
    )


def plot_selected_predictions(
    bootstrap_df: pd.DataFrame,
    figure_dir: Path,
    target: str,
) -> None:
    """Plot measured and bootstrap-predicted values for held-out Runs."""

    subset = (
        bootstrap_df[
            bootstrap_df[
                "target"
            ]
            == target
        ]
        .sort_values(
            "held_out_run"
        )
    )

    x = subset[
        "held_out_run"
    ].to_numpy(
        dtype=float
    )

    predicted = subset[
        "predicted_mean"
    ].to_numpy(
        dtype=float
    )

    lower_error = (
        predicted
        - subset[
            "ci95_low"
        ].to_numpy(
            dtype=float
        )
    )

    upper_error = (
        subset[
            "ci95_high"
        ].to_numpy(
            dtype=float
        )
        - predicted
    )

    measured = subset[
        "actual_run_mean"
    ].to_numpy(
        dtype=float
    )

    fig, ax = plt.subplots(
        figsize=(8, 5)
    )

    ax.plot(
        x,
        measured,
        marker="o",
        label="Measured Run mean",
    )

    ax.errorbar(
        x,
        predicted,
        yerr=np.vstack(
            [
                lower_error,
                upper_error,
            ]
        ),
        fmt="s",
        capsize=3,
        label=(
            "Predicted mean "
            "with 95% bootstrap CI"
        ),
    )

    ax.set_xlabel(
        "Held-out Run"
    )

    ax.set_ylabel(
        f"{target} "
        f"({UNITS[target]})"
    )

    ax.set_title(
        f"{target}: "
        f"{subset['model'].iloc[0]}"
    )

    ax.legend(
        frameon=False
    )

    save_figure(
        fig,
        figure_dir
        / f"{target.lower()}_selected_predictor",
    )


